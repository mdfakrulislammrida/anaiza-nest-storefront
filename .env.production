# Baked into the static export at build time. NEXT_PUBLIC_ vars end up in the
# browser bundle regardless, so none of this is secret.
#
# Precedence note: a variable set in the shell when you run `npm run build`
# beats every file. `.env.local` also beats this file (Next loads it for
# production builds too), which is why NEXT_PUBLIC_SITE_URL is deliberately NOT
# set in `.env.local` -- it used to be, and it leaked localhost into a deploy.
NEXT_PUBLIC_API_URL=https://api.anaizanest.com/api

# Staging defaults. At cutover, rebuild with the final domain and indexing on:
#   NEXT_PUBLIC_SITE_URL=https://anaizanest.com NEXT_PUBLIC_ALLOW_INDEXING=true npm run build
NEXT_PUBLIC_SITE_URL=https://new.anaizanest.com
NEXT_PUBLIC_ALLOW_INDEXING=false
