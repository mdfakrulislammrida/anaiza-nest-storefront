# Baked into the static export at build time — this is what the deployed
# site's client-side fetch calls point at. Not a secret (NEXT_PUBLIC_ vars
# end up in the browser bundle regardless of gitignore).
NEXT_PUBLIC_API_URL=https://api.anaizanest.com/api

# Public site origin, used for metadataBase (canonical/OG URL resolution)
# and the generated sitemap.xml. Assumed from the api.anaizanest.com API
# domain -- update this if the storefront's real public domain differs.
NEXT_PUBLIC_SITE_URL=https://anaizanest.com
