DirectoryIndex index.html

Options -Indexes

RewriteEngine On

# 1. Requests that map directly to a real file (assets, or an explicit
#    .html/.txt hit) pass through untouched.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Clean URL -> matching .html file, e.g. /account -> account.html, or
#    /product/<slug> -> product/<slug>.html for a product that existed at
#    build time (generateStaticParams generated that file).
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 3. Same, but for a trailing-slash request, e.g. /account/ -> account.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1.html [L]

# 4. Fallback for a product/page slug that didn't match a file in step 2 --
#    i.e. one added after the last build, so generateStaticParams didn't
#    know about it yet. Serves the client-only shell (product.html /
#    pages.html), which reads the real slug from the URL and fetches it
#    from the API directly, so brand new content still shows up without
#    waiting for the next rebuild (just without the static SEO benefits
#    until then).
RewriteRule ^product/.+$ /product.html [L]
RewriteRule ^pages/.+$ /pages.html [L]

# 5. Custom 404 page
ErrorDocument 404 /404.html
