DirectoryIndex index.html

Options -Indexes

RewriteEngine On

# 00. Paths that belong to the API. On the main domain the `api` folder at the site root is a symlink to the Laravel public folder
#     (and `storage` and `admin` are the same kind of link, if they exist there). Nothing in this file may rewrite, redirect or
#     answer them: the Laravel folder has its own .htaccess and handles its own paths. Every rule below is therefore reached
#     only by a path that is the shop's.
RewriteRule ^(api|storage|admin)(/|$) - [L]

# 00b. One address for the shop: https, and no www. (A host that ends https in front of the site, and says so in
#      X-Forwarded-Proto, is not redirected again, so this cannot loop.)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 0. Special prices moved from /hot-deals to /special-prices: a permanent redirect, any query string kept. It comes first,
#    before a real-file match could serve hot-deals.html (a small page that sends the visitor on in the browser, for a
#    host that does not read this file).
RewriteRule ^hot-deals(\.html)?/?$ /special-prices [R=301,L]

# 0b. When a visitor's phone has a link in view, Next fetches that page's small navigation file ahead of the tap. It asks for
#     /gift-finder/__next.gift-finder.__PAGE__.txt, but the build wrote it as /gift-finder/__next.gift-finder/__PAGE__.txt (the dots
#     of the name are folders on disk). Without these rules every such request was a 404: a red error in the browser console, and a
#     whole error page downloaded each time. Each rule fires only when the file it points to exists, one rule per depth (the
#     longest names are a page inside a dynamic route, like /blog/<slug>/__next.blog.$d$slug.__PAGE__.txt).
RewriteCond %{DOCUMENT_ROOT}/$1__next.$2/$3.txt -f
RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.txt$ $1__next.$2/$3.txt [L]
RewriteCond %{DOCUMENT_ROOT}/$1__next.$2/$3/$4.txt -f
RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.([^./]+)\.txt$ $1__next.$2/$3/$4.txt [L]
RewriteCond %{DOCUMENT_ROOT}/$1__next.$2/$3/$4/$5.txt -f
RewriteRule ^(.*/)?__next\.([^./]+)\.([^./]+)\.([^./]+)\.([^./]+)\.txt$ $1__next.$2/$3/$4/$5.txt [L]

# 1. Requests that map directly to a real file (assets, or an explicit
#    .html/.txt hit) pass through untouched.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Clean URL -> matching .html file, e.g. /account -> account.html, or
#    /product/<slug> -> product/<slug>.html for a product that existed at
#    build time (generateStaticParams generated that file).
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 3. Same, but for a trailing-slash request, e.g. /account/ -> account.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1.html [L]

# 3b. Addresses from the old site (docs/redirect-map.md has the table and the reasoning). Every one is a 301, and a trailing "?"
#     on the target drops the old query string (?sold=show and the like). They come after rules 1 to 3, so a page that exists in
#     this build (for example /category/gifts) is served as it is and only an address with no page of its own is redirected,
#     and before the client shells of rule 4, which would otherwise answer them with a "not found" page. Apache matches these
#     against the decoded path, so an old "%7C", "%E2%80%93" or "&" in a product address is matched by the "." in the pattern.
#
#     Old products: /product/<slug>-<3-digit id>. The old ids (194 to 207) end the address; a new product's address does not
#     end in a number like that, and one that does is served by rule 2 as soon as it is in the build. Sent to the same piece when
#     the new shop has it, else to the category its words name, else to /shop. Never to the home page, never a 404.
RewriteRule ^product/.*coffee-cup.*-[0-9]{3}/?$ /product/morris-ceramic-coffee-cup-and-saucer-set? [R=301,L]
RewriteRule ^product/.*coaster.*-[0-9]{3}/?$ /product/tea-coaster-set-of-6-with-holder? [R=301,L]
RewriteRule ^product/.*tea-jar.*-[0-9]{3}/?$ /category/tea-jars? [R=301,L]
RewriteRule ^product/.*tea-set.*-[0-9]{3}/?$ /category/tea-sets? [R=301,L]
RewriteRule ^product/.*(cup|mug).*-[0-9]{3}/?$ /category/cups-and-mugs? [R=301,L]
RewriteRule ^product/.*gift.*-[0-9]{3}/?$ /category/gifts? [R=301,L]
RewriteRule ^product/.+-[0-9]{3}/?$ /shop? [R=301,L]
#     Old categories that the new shop does not have (the ones it has, like gifts, are served by rule 2) and every old sub-category.
RewriteRule ^category/(car-accessories|music-accessories|mobile-accessories|electronic-gadgets|watches|pc-accessories|laptop-&-computer|baby-items|lifestyle)/?$ /shop? [R=301,L]
RewriteRule ^subcategory(/.*)?$ /shop? [R=301,L]
#     Old information pages.
RewriteRule ^page/order-procedure/?$ /faq? [R=301,L]
RewriteRule ^page/delivery-rules/?$ /pages/shipping? [R=301,L]
RewriteRule ^page/return-policy/?$ /pages/returns? [R=301,L]
RewriteRule ^page/terms-&-conditions/?$ /pages/terms? [R=301,L]
RewriteRule ^page/privacy-policy/?$ /pages/privacy? [R=301,L]
RewriteRule ^page/test/?$ / [R=301,L]
RewriteRule ^page(/.*)?$ /shop? [R=301,L]
RewriteRule ^site/contact-us/?$ /contact? [R=301,L]
#     Old customer area. The sign-in, sign-up and forgot-password forms are all on /account (the last two are opened by ?mode=).
RewriteRule ^customer/login/?$ /account? [R=301,L]
RewriteRule ^customer/register/?$ /account?mode=register [R=301,L]
RewriteRule ^customer/forgot-password/?$ /account?mode=forgot [R=301,L]
RewriteRule ^customer/checkout/?$ /checkout? [R=301,L]
RewriteRule ^customer/order-track/?$ /track-order? [R=301,L]
RewriteRule ^customer(/.*)?$ /account? [R=301,L]

# 4. Fallback for a product/page/category/article slug that didn't match a file
#    in step 2 -- i.e. one added after the last build, so generateStaticParams
#    didn't know about it yet. Serves a client-only shell, which reads the
#    real slug from the URL and fetches it from the API directly, so brand
#    new content still shows up without waiting for the next rebuild (just
#    without the static SEO benefits until then).
#    /blog is a real listing page (unlike /product and /pages, which only
#    exist as fallback targets), so its shell lives at a separate route,
#    /article, rather than reusing /blog.html for double duty.
RewriteRule ^product/.+$ /product.html [L]
RewriteRule ^pages/.+$ /pages.html [L]
RewriteRule ^category/.+$ /category.html [L]
RewriteRule ^blog/.+$ /article.html [L]
#    Landing pages (/lp/<slug>) made in the admin after the last build: the same
#    client-only shell idea, so a new page works at once.
RewriteRule ^lp/.+$ /lp.html [L]

# 5. Custom 404 page
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Security headers. Set on every response (including errors) by the host, since
# a static export has no server of its own to set them.
#
# The Content-Security-Policy is REPORT ONLY for now: the browser lists anything
# it would have blocked in its console (DevTools > Console) and blocks nothing.
# Browse the shop with a pixel and the cookie banner on, fix the allow-lists
# below for anything legitimate that is listed, then change the header name
# "Content-Security-Policy-Report-Only" to "Content-Security-Policy" to enforce.
# 'unsafe-inline' stays in script-src and style-src because the pages carry their
# own inline start-up script and styles; the value of the policy is that it names
# every other place a script, frame, form or connection may come from.
#
# When the site has run on HTTPS only for a while, add (it cannot be taken back
# quickly, browsers remember it for the whole max-age):
#   Header always set Strict-Transport-Security "max-age=15552000"
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset X-Powered-By

  # Enforced: nobody else may put the shop in a frame (frame-ancestors is ignored in report-only mode).
  Header always set Content-Security-Policy "frame-ancestors 'self'"

  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' https:; connect-src 'self' https://api.anaizanest.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.doubleclick.net https://www.facebook.com https://connect.facebook.net https://analytics.tiktok.com https://*.tiktok.com; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://www.googletagmanager.com https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---------------------------------------------------------------------------
# Performance: compression + caching. Each block is wrapped in <IfModule> so a
# host without that module just skips it instead of returning a 500.
# ---------------------------------------------------------------------------

# 6. Compression (Brotli for clients that accept it, gzip otherwise).
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Tell caches the response differs by Accept-Encoding.
  <FilesMatch "\.(html|css|js|json|svg|xml|txt)$">
    Header append Vary Accept-Encoding
  </FilesMatch>

  # 7. Cache headers.
  # Build output under /_next/static/ has a content hash in every filename, so
  # a changed file always gets a new URL and the old one can be cached forever.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Fonts and images. (.ico is left out: favicon.ico keeps the same name when
  # it changes. Note files in the site root such as svgs are not content-hashed
  # either, so replacing one of those means giving it a new filename.)
  <FilesMatch "\.(woff2?|ttf|otf|eot|png|jpe?g|gif|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The favicon keeps its name when it changes, so a day, not a year.
  <FilesMatch "\.ico$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # HTML, the navigation payloads (.txt), sitemap/robots/llms.txt: always
  # revalidate, so a new deployment shows up right away. 304s keep it cheap.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
