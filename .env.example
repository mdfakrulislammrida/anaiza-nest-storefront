NEXT_PUBLIC_API_URL=http://localhost:8787/api

# Public origin used for canonicals, sitemap, robots, llms.txt and JSON-LD.
# Defaults to https://new.anaizanest.com when unset.
# NEXT_PUBLIC_SITE_URL=https://new.anaizanest.com

# Only "true" lets search engines index the build; anything else is staging
# (robots.txt Disallow: / and noindex on every page).
# NEXT_PUBLIC_ALLOW_INDEXING=false
